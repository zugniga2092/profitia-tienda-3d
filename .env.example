# Copia este archivo como .env.local (para probar en tu ordenador) y pon tus claves.
# En Vercel, estas mismas variables van en: Project → Settings → Environment Variables.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# Diseñador con IA (opcional). Clave SECRETA (empieza por sk_) de https://enter.pollinations.ai
# Permisos: solo Image y Text, y ponle un presupuesto máximo.
POLLINATIONS_API_KEY=

# Probador con cámara (opcional). Clave de https://platform.decart.ai
DECART_API_KEY=

# Tu dominio propio, si tienes (separa varios con comas). Los dominios de Vercel se detectan solos.
# Ejemplo: ALLOWED_ORIGINS=https://mitienda.com,https://www.mitienda.com
ALLOWED_ORIGINS=

# Opcionales: modelos de Pollinations
# POLLINATIONS_MODEL=tongyi-mai/z-image-turbo
# POLLINATIONS_DIRECTOR=openai/gpt-5.4-mini
